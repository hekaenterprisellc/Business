# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local / editor
local-*
.claude
.z-ai-config
prompt

# logs
*.log
dev.log
dev.out.log
server.log

# ===== Sandbox / runtime artifacts (not part of the app) =====
/skills/
/.zscripts/
/download/
/upload/
/examples/
/tests/
/mini-services/
/db/*.db
/db/*.db-journal
